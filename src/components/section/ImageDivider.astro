---
import { Image } from 'astro:assets';
import dividerImg from '../../assets/divider-interior.jpg';
---

<section class="divider" aria-hidden="true">
  <div
    class="divider_media"
    data-parallax="trigger"
    data-parallax-scroll-start="top top"
    data-parallax-start="0"
    data-parallax-end="40"
    data-parallax-scrub="1"
  >
    <Image
      src={dividerImg}
      alt=""
      width={1500}
      height={1000}
      loading="lazy"
      format="webp"
      quality={80}
      sizes="100vw"
    />
  </div>
  <div class="divider_overlay"></div>
</section>

<style>
  /* Mask: clips the taller bg wrapper */
  .divider {
    position: relative;
    width: 100%;
    height: 100dvh;
    overflow: clip;
    background-color: var(--color-bg);
  }

  /* Taller bg wrapper — trigger and target in one. 120% height gives the image room to drift. */
  .divider_media {
    position: absolute;
    width: 100%;
    height: 120%;
    will-change: transform;
  }
  .divider_media :global(img) {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .divider_overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-overlay);
    pointer-events: none;
  }
</style>
