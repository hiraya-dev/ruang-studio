---
import { Image } from 'astro:assets';
import { home } from '../../data/home';
import aboutImg from '../../assets/about-studio.jpg';

const { eyebrow, heading, body, note, imageAlt } = home.about;
---

<section id="about" class="about" aria-labelledby="about-eyebrow">
  <div class="container">
    <div class="about_grid section_grid">
      <figure class="about_media">
        <Image
          src={aboutImg}
          alt={imageAlt}
          width={720}
          height={932}
          loading="lazy"
          format="webp"
          quality={82}
          sizes="(min-width: 50em) 48vw, 90vw"
        />
      </figure>

      <div class="about_body">
        <div class="about_lead">
          <p id="about-eyebrow" class="about_eyebrow">{eyebrow}</p>
          <h2 class="about_heading">{heading}</h2>
        </div>

        <div class="about_detail">
          <p class="about_text">{body}</p>
          <p class="about_note">{note}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background-color: var(--color-bg);
    padding-block: var(--space-8);
  }

  .about_grid {
    align-items: stretch;
  }

  /* Image — left half (cols 1–6) */
  .about_media {
    grid-column: 1 / 7;
    margin: 0;
    aspect-ratio: 720 / 932;
    overflow: clip;
  }
  .about_media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Text — right half (cols 7–12), top group and bottom group pushed apart */
  .about_body {
    grid-column: 7 / 13;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .about_lead,
  .about_detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .about_eyebrow,
  .about_note {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-xs);
    line-height: var(--leading-ui);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fg);
  }

  .about_heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h1);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
  }

  .about_text {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-large);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
  }
</style>
