---
import { home } from '../../data/home';
import { site } from '../../data/site';
import Button from '../ui/Button.astro';

const { eyebrow, heading, intro, fields, process, referral, submit, signoffPrefix } =
  home.contact;
---

<section id="contact" class="contact" aria-labelledby="contact-eyebrow">
  <div class="container">
    <p id="contact-eyebrow" class="contact_eyebrow">{eyebrow}</p>
    <h2 class="contact_heading" data-split="heading">{heading}</h2>

    <div class="contact_main section_grid">
      <div class="contact_left">
        <div class="contact_intros">
          <p class="contact_intro">{intro[0]}</p>
          <p class="contact_intro">{intro[1]}</p>
        </div>
        <p class="contact_signoff">
          {signoffPrefix} — <a class="contact_email" href={`mailto:${site.email}`} data-underline-link>{site.email}</a>
        </p>
      </div>

      <form class="contact_form" name="contact" method="post">
        <p class="field">
          <label class="u-visually-hidden" for="cf-name">{fields.name.label}</label>
          <input
            class="field_control"
            id="cf-name"
            name="name"
            type="text"
            autocomplete="name"
            placeholder={fields.name.placeholder}
          />
        </p>

        <p class="field">
          <label class="u-visually-hidden" for="cf-email">{fields.email.label}</label>
          <input
            class="field_control"
            id="cf-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder={fields.email.placeholder}
          />
        </p>

        <p class="field field--area">
          <label class="u-visually-hidden" for="cf-message">{fields.message.label}</label>
          <textarea
            class="field_control"
            id="cf-message"
            name="message"
            rows="4"
            placeholder={fields.message.placeholder}></textarea>
        </p>

        <p class="field field--select">
          <label class="u-visually-hidden" for="cf-process">{process.label}</label>
          <select class="field_control" id="cf-process" name="process">
            <option value="" disabled selected>{process.label}</option>
            {process.options.map((opt) => <option value={opt}>{opt}</option>)}
          </select>
          <svg class="field_chevron" viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
            <path d="M6 10l6 6 6-6" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
          </svg>
        </p>

        <p class="field field--select">
          <label class="u-visually-hidden" for="cf-referral">{referral.label}</label>
          <select class="field_control" id="cf-referral" name="referral">
            <option value="" disabled selected>{referral.label}</option>
            {referral.options.map((opt) => <option value={opt}>{opt}</option>)}
          </select>
          <svg class="field_chevron" viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
            <path d="M6 10l6 6 6-6" stroke="currentColor" stroke-width="1" stroke-linecap="square" />
          </svg>
        </p>

        <Button type="submit" class="contact_submit">{submit}</Button>
      </form>
    </div>

  </div>
</section>

<style>
  .contact {
    background-color: var(--color-bg);
    border-block: var(--border-width) solid var(--color-border);
    padding-block: var(--space-8);
  }

  .contact_eyebrow {
    margin: 0 0 var(--space-8);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-xs);
    line-height: var(--leading-ui);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fg);
  }

  .contact_heading {
    margin: 0 0 var(--space-20);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
  }

  .contact_main {
    align-items: stretch;
  }

  /* Left column: intros (side by side on desktop) + signoff pinned to bottom */
  .contact_left {
    grid-column: 1 / 7;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .contact_intros {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gutter);
  }

  .contact_intro {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-large);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
  }

  .contact_form {
    grid-column: 7 / 13;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* ---- Fields ---- */
  .field {
    position: relative;
    margin: 0;
    display: flex;
  }

  .field_control {
    width: 100%;
    padding: var(--space-2); /* 8px */
    background-color: transparent;
    border: 0;
    border-bottom: var(--border-width) solid var(--color-border);
    border-radius: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-large);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
  }

  .field_control::placeholder { color: var(--color-fg-muted); }

  .field--area .field_control {
    min-height: 10.625rem; /* 170px */
    resize: vertical;
  }

  .field--select .field_control {
    appearance: none;
    padding-right: 2rem; /* room for chevron */
    cursor: pointer;
  }
  /* The unselected placeholder option reads as muted (no `required` needed) */
  .field--select .field_control:has(option[value=""]:checked) {
    color: var(--color-fg-muted);
  }

  .field_chevron {
    position: absolute;
    right: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-fg);
    pointer-events: none;
  }

  /* ---- Interaction states (focus / hover / active) ---- */
  .field_control:hover {
    background-color: color-mix(in srgb, var(--color-fg) 5%, transparent);
  }
  .field_control:focus {
    outline: none;
    /* second underline px without shifting layout */
    box-shadow: inset 0 -1px 0 0 var(--color-fg);
    background-color: color-mix(in srgb, var(--color-fg) 5%, transparent);
  }
  .field_control:active {
    background-color: color-mix(in srgb, var(--color-fg) 9%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .field_control {
      transition:
        background-color var(--duration-fast) var(--ease-out-quart),
        box-shadow var(--duration-fast) var(--ease-out-quart);
    }
  }

  .contact_submit {
    align-self: flex-start;
  }

  .contact_signoff {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-small);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    color: var(--color-fg);
  }
  .contact_email {
    color: inherit;
    text-decoration: none;
  }

  @container (width < 50em) {
    .contact_left  { grid-column: 1 / 3; }
    .contact_form  { grid-column: 3 / -1; }
    .contact_intros { grid-template-columns: 1fr; gap: var(--space-6); }
  }

  @container (width < 35em) {
    .contact_main    { row-gap: var(--space-8); }
    .contact_left    { grid-column: 1 / -1; justify-content: flex-start; }
    .contact_form    { grid-column: 1 / -1; }
    .contact_signoff { display: none; }
  }
</style>
