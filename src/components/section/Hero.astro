---
import { Image } from 'astro:assets';
import heroImg from '../../assets/hero.jpg';

interface Props {
  headline: string;
  tagline: string;
}

const { headline, tagline } = Astro.props;
---

<section class="hero" aria-label="Hero">
  <div class="container hero_container">
    <div class="hero_text">
      <h1 class="hero_headline">{headline}</h1>
      <p class="hero_tagline">{tagline}</p>
    </div>

    <figure class="hero_media">
      <Image
        src={heroImg}
        alt="Bukit Timah Residence — living room with caramel sofa, monstera plant, and full-height glazing"
        width={1460}
        height={820}
        loading="eager"
        fetchpriority="high"
        format="webp"
        quality={85}
        sizes="(min-width: 64em) 92vw, 100vw"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-bg);
  }

  .hero_container {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--space-8);
    min-height: 100dvh;
    padding-block-start: var(--space-hero-pt);
    padding-block-end: var(--space-8);
  }

  .hero_text {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
  }

  .hero_headline {
    margin: 0;
    max-width: 37.3125rem;
    min-width: 0;
    text-wrap: balance;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h1);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
  }

  .hero_tagline {
    margin: 0;
    flex-shrink: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-small);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    text-align: right;
    color: var(--color-fg);
    white-space: nowrap;
  }

  .hero_media {
    position: relative;
    min-height: 0;
    margin: 0;
    overflow: hidden;
  }

  .hero_media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (width < 64em) {
    .hero_container {
      min-height: auto;
      grid-template-rows: auto auto;
    }

    .hero_media {
      aspect-ratio: 16 / 9;
    }
  }

  @container (width < 35em) {
    .hero_text {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero_tagline {
      text-align: left;
      white-space: normal;
    }

    .hero_headline {
      max-width: none;
    }
  }
</style>
