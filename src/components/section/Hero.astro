---
import { Image } from 'astro:assets';
import heroImg from '../../assets/hero.jpg';

interface Props {
  headline: string;
  tagline: string;
}

const { headline, tagline } = Astro.props;
---

<section class="hero" aria-label="Hero">
  <div class="hero_text">
    <h1 class="hero_headline">{headline}</h1>
    <p class="hero_tagline" aria-label={tagline}>{tagline}</p>
  </div>

  <div class="hero_image">
    <Image
      src={heroImg}
      alt="Bukit Timah Residence — living room with caramel sofa, monstera plant, and full-height glazing"
      width={1460}
      height={820}
      loading="eager"
      fetchpriority="high"
      format="webp"
      quality={85}
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    max-width: var(--container-max); /* locks at 1920px */
    margin-inline: auto;
    height: 100dvh; /* full viewport; image flexes to fill the space below the text */
    background-color: var(--color-bg);
    overflow: clip;
  }

  .hero_text {
    position: absolute;
    top: 12.3125rem; /* 197px */
    left: var(--site-margin);
    right: var(--site-margin);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .hero_headline {
    width: 37.3125rem; /* 597px */
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h1);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
  }

  .hero_tagline {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-small);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    text-align: right;
    color: var(--color-fg);
    white-space: nowrap;
  }

  /* Photo — full content width, flexes from the text zone to the bottom padding */
  .hero_image {
    position: absolute;
    top: 24.8125rem; /* 397px */
    left: var(--site-margin);
    right: var(--site-margin);
    bottom: var(--space-8); /* 32px — matches the Figma bottom gap */
  }

  .hero_image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
